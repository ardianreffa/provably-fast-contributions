+use crate::kc0::shake256;
+use crate::nt0::ntt;
+use crate::pk0::{hint_valid,t1_scaled_by,use_hints_words_residue,z_unpack};
+use crate::sa0::{ball_offsets_bytes,expand_a};
+pub const PK_BYTES:u32=1312;
+pub const SIG_BYTES:u32=2420;
+const C_TILDE_BYTES:u32=32;
+const T1_BYTES:u32=320;
+const Z_BYTES:u32=576;
+const HINT_AT:u32=2336;
+const OMEGA:u32=80;
+use corelib_imports::bounded_int::upcast;
+pub fn verify_internal(pk:Span<u8>,message_prime:Span<u8>,sig:Span<u8>)->bool{
+if pk.len()!=PK_BYTES{
+return false;
+}
+let tr=shake256(pk,64);
+let mut input:Array<u8>=array![];
+input.append_span(tr.span());
+input.append_span(message_prime);
+let mu=shake256(input.span(),64);
+verify_mu(pk,mu.span(),sig)
+}
+pub fn verify_mu(pk:Span<u8>,mu:Span<u8>,sig:Span<u8>)->bool{
+verify_mu_z(pk,mu,sig,Option::None,Option::None)
+}
+pub fn verify_mu_z(
+pk:Span<u8>,mu:Span<u8>,sig:Span<u8>,zf:Option<Span<felt252>>,
+pre:Option<(Span<Span<crate::sa0::C24>>,Span<felt252>)>,
+)->bool{
+verify_mu_w(pk,mu,sig,zf,pre,None,None)
+}
+pub fn verify_mu_w(
+pk:Span<u8>,mu:Span<u8>,sig:Span<u8>,zf:Option<Span<felt252>>,
+pre:Option<(Span<Span<crate::sa0::C24>>,Span<felt252>)>,muw:Option<Span<u128>>,ctv:Option<u256>,
+)->bool{
+let sig_len=if ctv.is_some(){
+OMEGA+4
+}else if zf.is_some(){
+C_TILDE_BYTES+OMEGA+4
+}else{
+SIG_BYTES
+};
+if(pre.is_none()&&pk.len()!=PK_BYTES)||sig.len()!=sig_len||(muw.is_none()&&mu.len()!=64){
+return false;
+}
+let hint=sig.slice(sig_len-OMEGA-4,OMEGA+4);
+if !hint_valid(hint){
+return false;
+}
+let mut z_hat:Array<Span<crate::nttu::Residue>>=array![];
+match zf{
+Some(zs)=>{
+let mut j=0;
+while j !=4{
+z_hat.append(ntt(zs.slice(256*j,256)).span());
+j+=1;
+}
+},
+None=>{
+let mut j=0;
+while j !=4{
+match z_unpack(sig.slice(C_TILDE_BYTES+Z_BYTES*j,Z_BYTES)){
+Some(z)=>z_hat.append(ntt(z.span()).span()),
+None=>{break;},
+}
+j+=1;
+}
+},
+}
+if z_hat.len()!=4{
+return false;
+}
+let z_hat=z_hat.span();
+let(a_hat,t1s)=match pre{
+Some((a,t))=>(a,Some(t)),
+None=>(expand_a(pk.slice(0,32)).span(),None),
+};
+let c_tilde=if ctv.is_some(){
+sig.slice(0,0)
+}else{
+sig.slice(0,C_TILDE_BYTES)
+};
+let offs=match ctv{
+Some(v)=>{
+let n64:NonZero<u128>=0x10000000000000000_u128.try_into().unwrap();
+let(l1,l0)=DivRem::div_rem(v.low,n64);
+let(l3,l2)=DivRem::div_rem(v.high,n64);
+crate::sa0::ball_offsets_lanes(l0,l1,l2,l3)
+},
+None=>ball_offsets_bytes(c_tilde),
+};
+let f:Span<felt252>=match t1s{
+Some(t)=>t,
+None=>{
+let mut rows:Array<felt252>=array![];
+let mut sc:felt252=1;
+let mut i=0;
+while i !=4{
+t1_scaled_by(pk.slice(32+T1_BYTES*i,T1_BYTES),sc,ref rows);
+sc*=0x40000;
+i+=1;
+}
+crate::ct::slices(rows.span()).span()
+},
+};
+let corr=crate::ct::corrections(crate::ct::sum39(f,offs.span()).span());
+let mut h_input:Array<u64>=array![];
+if let Some(w)=muw{
+for l in w{
+h_input.append((*l).try_into().unwrap());
+}
+}
+let mut mb=mu;
+while let Some(g)=mb.multi_pop_front::<8>(){
+let[b0,b1,b2,b3,b4,b5,b6,b7]=(*g).unbox();
+let v:felt252=b0.into()+0x100*b1.into()+0x10000*b2.into()+0x1000000*b3.into()
++0x100000000*b4.into()+0x10000000000*b5.into()+0x1000000000000*b6.into()
++0x100000000000000*b7.into();
+h_input.append(v.try_into().unwrap());
+}
+let mut first:u32=0;
+let mut i=0;
+while i !=4{
+let w_approx=crate::nttu::intt_row(a_hat.slice(4*i,4),z_hat,corr.at(i).span());
+let end:u32=(*hint.at(OMEGA+i)).into();
+use_hints_words_residue(w_approx.span(),hint.slice(first,end-first),ref h_input);
+first=end;
+i+=1;
+}
+if let Some(v)=ctv{
+return crate::kc0::shake256_32_words(h_input.span())==v;
+}
+let mut ct=c_tilde;
+let mut low:u128=0;
+let mut high:u128=0;
+let mut scale:u128=1;
+let mut k=0;
+while k !=16{
+low+=(*ct.pop_front().unwrap()).into()*scale;
+if k !=15{
+scale*=256;
+}
+k+=1;
+}
+scale=1;
+k=0;
+while k !=16{
+high+=(*ct.pop_front().unwrap()).into()*scale;
+if k !=15{
+scale*=256;
+}
+k+=1;
+}
