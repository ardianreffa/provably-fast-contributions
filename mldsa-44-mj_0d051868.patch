+keep(c3,ref a);
+keep(c4,ref a);
+let c5:felt252=zu::<Q72,felt252>(c5_low)+zu::<R16,felt252>(c5_high)*0x100;
+keep(c5.try_into().unwrap(),ref a);
+keep(c6,ref a);
+let c7:felt252=zu::<Q88,felt252>(c7);
+keep(c7.try_into().unwrap(),ref a);
+}
