+pub fn expand_a(rho:Span<u8>)->Array<Span<C24>>{
+let mut b=rho;
+let mut lanes:Array<u128>=array![];
+let mut l=0;
+while l !=4{
+let mut v:u128=0;
+let mut scale:u128=1;
+let mut k=0;
+while k !=8{
+v+=(*b.pop_front().unwrap()).into()*scale;
+if k !=7{
+scale*=256;
+}
+k+=1;
+}
+lanes.append(v);
+l+=1;
+}
+expand_a_lanes(*lanes.at(0),*lanes.at(1),*lanes.at(2),*lanes.at(3))
+}
+pub fn expand_a_lanes(r0:u128,r1:u128,r2:u128,r3:u128)->Array<Span<C24>>{
+let mut out:Array<Span<C24>>=array![];
+crate::x2::expand_a_from(r0,r1,r2,r3,0,ref out);
+out
+}
