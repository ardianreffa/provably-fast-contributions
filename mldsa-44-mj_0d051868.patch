+/// A hit: position `j` already held a sign, which moves to `i`; `off` is the new entry for `j`.
+#[inline(never)]
+fn ball_hit(ref list:Array<u32>,ref hi:u128,i:u32,j:u32,off:u32){
+let mut moved:u32=0;
+let mut new:Array<u32>=array![];
+let plus=256-j;
+let minus=512-j;
+for e in list.span(){
+let o=*e;
+if o==plus{
+moved=256-i;
+}else if o==minus{
+moved=512-i;
+}else{
+new.append(o);
+}
+}
+new.append(off);
+new.append(moved);
+list=new;
+hi=hi+*BIT.span().at(i-128);
+}
+/// A hit on position `j` (bit `b` of the half whose sign bits are `sj`): position `i` takes the
+/// sign `j` held and `j` takes the new sign `sb`. When the two signs agree the entry for `j` is
+/// already right and only `i` is appended; otherwise the one stale entry for `j` is dropped by
+/// `ball_flip`. Returns the updated `sj` and the sign bit to add for `i` in the upper half.
+#[inline(never)]
+fn sign_hit(ref list:Array<u32>,ref hi:u128,sj:felt252,i:u32,j:u32,off:u32,sb:B1,b:u128)->(felt252,felt252){
+let sjw:u128=sj.try_into().unwrap();
+let old=sjw&b!=0;
+let new=zu::<_,felt252>(sb)==1;
+let bi=*BIT.span().at(i-128);
+let add=if old{bi.into()}else{0};
+hi=hi+bi;
+if old==new{
+list.append(off+j-i);
+return (sj,add);
+}
+let(stale,moved)=if old{(512-j,512-i)}else{(256-j,256-i)};
+ball_flip(ref list,stale,off,moved);
+if new{(sj+b.into(),add)}else{(sj-b.into(),add)}
+}
+/// Rebuilds `list` without the entry `stale`, then appends `off` and `moved`.
+#[inline(never)]
+fn ball_flip(ref list:Array<u32>,stale:u32,off:u32,moved:u32){
+let mut sp=list.span();
+let mut new:Array<u32>=array![];
+while let Some(c)=sp.multi_pop_front::<8>(){
+let[e0,e1,e2,e3,e4,e5,e6,e7]=(*c).unbox();
+if e0!=stale{new.append(e0);}
+if e1!=stale{new.append(e1);}
+if e2!=stale{new.append(e2);}
+if e3!=stale{new.append(e3);}
+if e4!=stale{new.append(e4);}
+if e5!=stale{new.append(e5);}
+if e6!=stale{new.append(e6);}
+if e7!=stale{new.append(e7);}
+}
+for e in sp{
+if *e!=stale{new.append(*e);}
+}
+new.append(off);
+new.append(moved);
+list=new;
+}
+/// One SampleInBall draw: byte `j` against the current index `i` (skipped when j > i).
+#[inline(always)]
+fn bstep(j:R8,ref signs:U64,ref lo:u128,ref hi:u128,ref slo:felt252,ref shi:felt252,ref list:Array<u32>,ref i:u32,two:NonZero<ZU<2>>,k256:ZU<256>,n128:ZU<128>,bit:Span<u128>){
+let ju:u32=zu(j);
+if ju>i{
+return;
+}
+let(rest,sb)=zq::div_rem(signs,two);
+signs=zu(rest);
+let off:u32=zu(zq::sub(zq::add(zq::mul(sb,k256),k256),j));
+match constrain::<R8,128>(j){
+Ok(jl)=>{
+let b=*bit.at(zu(jl));
+if lo&b==0{
+lo=lo|b;
+slo=slo+zu::<_,felt252>(sb)*b.into();
+list.append(off);
+}else{
+let(n,a)=sign_hit(ref list,ref hi,slo,i,ju,off,sb,b);
+slo=n;
+shi=shi+a;
+}
+},
+Err(jh)=>{
+let b=*bit.at(zu(zq::sub(jh,n128)));
+if hi&b==0{
+hi=hi|b;
+shi=shi+zu::<_,felt252>(sb)*b.into();
+list.append(off);
+}else{
+let(n,a)=sign_hit(ref list,ref hi,shi,i,ju,off,sb,b);
+shi=n+a;
+}
+},
+}
+i+=1;
+}
+pub(crate)fn ball_offsets(state:[u128;25])->Array<u32>{
+let st=state.span();
+let ns:NonZero<ZU<0x10000000000000000>>=0x10000000000000000;
+let(signs,_)=zq::div_rem(*st.at(0),ns);
+let mut signs:U64=signs;
+let mut words=st.slice(1,16);
+let two:NonZero<ZU<2>>=2;
+let n8:NonZero<ZU<0x100>>=N100;
+let k256:ZU<256>=256;
+let n128:ZU<128>=128;
+let bit=BIT.span();
+let mut lo:u128=0;
+let mut hi:u128=0;
+let mut slo:felt252=0;
+let mut shi:felt252=0;
+let mut list:Array<u32>=array![];
+let mut i:u32=256-TAU;
+let mut slow=false;
+loop{
+let w=match words.pop_front(){
+Some(w)=>*w,
+None=>{
+slow=true;
+break;
+},
+};
+let(w,_)=zq::div_rem(w,ns);
+let(w,b0)=zq::div_rem(w,n8);
+bstep(b0,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b1)=zq::div_rem(w,n8);
+bstep(b1,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b2)=zq::div_rem(w,n8);
+bstep(b2,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b3)=zq::div_rem(w,n8);
+bstep(b3,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b4)=zq::div_rem(w,n8);
+bstep(b4,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b5)=zq::div_rem(w,n8);
+bstep(b5,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(b7,b6)=zq::div_rem(w,n8);
+bstep(b6,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+bstep(b7,ref signs,ref lo,ref hi,ref slo,ref shi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+};
+if slow{
+return ball_slow(state,zu(signs),lo,hi,list,i);
+}
+list
+}
+#[inline(always)]
+fn ball_step(bit:Span<u128>,ref lo:u128,ref hi:u128,ref list:Array<u32>,i:u32,j:u32,s:u32){
+let hit=if j<128{
+let b=*bit.at(j);
+if lo&b==0{
+lo=lo+b;
+false
+}else{
+true
+}
+}else{
+let b=*bit.at(j-128);
+if hi&b==0{
+hi=hi+b;
+false
+}else{
+true
+}
+};
+if hit{
+ball_hit(ref list,ref hi,i,j,s-j);
+}else{
+list.append(s-j);
+}
+}
+fn ball_slow(state:[u128;25],signs:u128,lo:u128,hi:u128,list:Array<u32>,i:u32)->Array<u32>{
+let mut signs=signs;
+let mut lo=lo;
+let mut hi=hi;
+let mut list=list;
+let mut i=i;
+let mut st=crate::k2::keccak_f1600_x2(state);
+let mut words=st.span().slice(0,17);
+let mut cur:u128=0;
+let mut left:u32=0;
+let two:NonZero<u128>=2_u128.try_into().unwrap();
+let byte:NonZero<u128>=256_u128.try_into().unwrap();
+let bit=BIT.span();
+while i !=256{
+if left==0{
+let w=match words.pop_front(){
+Some(w)=>*w,
+None=>{
+st=crate::k2::keccak_f1600_x2(st);
+let mut l=st.span().slice(0,17);
+let first=*l.pop_front().unwrap();
+words=l;
+first
+},
+};
+let(_,c)=crate::x2::halves(w);
+cur=c;
+left=8;
+}
+let(rest,b)=DivRem::div_rem(cur,byte);
+cur=rest;
+left-=1;
+let j:u32=b.try_into().unwrap();
+if j<=i{
+let(rest,sign)=DivRem::div_rem(signs,two);
+signs=rest;
+let s:u32=if sign==0{
+256
+}else{
+512
+};
+ball_step(bit,ref lo,ref hi,ref list,i,j,s);
+i+=1;
+}
+}
+list
+}
