-            Some(bytes) => bytes,
-            None => { return false; },
-        };
-        let sig = match encoding::felts_to_bytes(signature, verify::SIG_BYTES) {
-            Some(bytes) => bytes,
-            None => { return false; },
-        };
-        verify::verify_internal(pk.span(), encoding::message_prime(message_hash).span(), sig.span())
-    }
+pub const PK_FELTS:u32=43;
+pub const SIG_FELTS:u32=79;
