+impl OffA of corelib_imports::bounded_int::AddHelper<BoundedInt<0,256>,UnitInt<256>>{type Result=BoundedInt<256,512>;}
+impl OffS of corelib_imports::bounded_int::bounded_int::SubHelper<BoundedInt<256,512>,R8>{type Result=BoundedInt<1,512>;}
+/// A hit: position `j` already held a sign, which moves to `i`; `off` is the new entry for `j`.
+#[inline(never)]
+fn ball_hit(ref list:Array<u32>,ref hi:u128,i:u32,j:u32,off:u32){
+let mut moved:u32=0;
+let mut new:Array<u32>=array![];
+let plus=256-j;
+let minus=512-j;
+for e in list.span(){
+let o=*e;
+if o==plus{
+moved=256-i;
+}else if o==minus{
+moved=512-i;
+}else{
+new.append(o);
+}
+}
+new.append(off);
+new.append(moved);
+list=new;
+hi=hi+*BIT.span().at(i-128);
+}
+/// One SampleInBall draw: byte `j` against the current index `i` (skipped when j > i).
+#[inline(always)]
+fn bstep(j:R8,ref signs:U64,ref lo:u128,ref hi:u128,ref list:Array<u32>,ref i:u32,two:NonZero<UnitInt<2>>,k256:UnitInt<256>,n128:UnitInt<128>,bit:Span<u128>){
+let ju:u32=upcast(j);
+if ju>i{
+return;
+}
+let(rest,sb)=bounded_int::div_rem(signs,two);
+signs=upcast(rest);
+let off:u32=upcast(bounded_int::sub(bounded_int::add(bounded_int::mul(sb,k256),k256),j));
+match constrain::<R8,128>(j){
+Ok(jl)=>{
+let b=*bit.at(upcast(jl));
+if lo&b==0{
+lo=lo+b;
+list.append(off);
+}else{
+ball_hit(ref list,ref hi,i,ju,off);
+}
+},
+Err(jh)=>{
+let b=*bit.at(upcast(bounded_int::sub(jh,n128)));
+if hi&b==0{
+hi=hi+b;
+list.append(off);
+}else{
+ball_hit(ref list,ref hi,i,ju,off);
+}
+},
+}
+i+=1;
+}
+pub(crate)fn ball_offsets(state:[u128;25])->Array<u32>{
+let st=state.span();
+let ns:NonZero<UnitInt<0x10000000000000000>>=0x10000000000000000;
+let(signs,_)=bounded_int::div_rem(*st.at(0),ns);
+let mut signs:U64=signs;
+let mut words=st.slice(1,16);
+let two:NonZero<UnitInt<2>>=2;
+let n8:NonZero<UnitInt<0x100>>=N100;
+let k256:UnitInt<256>=256;
+let n128:UnitInt<128>=128;
+let bit=BIT.span();
+let mut lo:u128=0;
+let mut hi:u128=0;
+let mut list:Array<u32>=array![];
+let mut i:u32=256-TAU;
+let mut slow=false;
+loop{
+let w=match words.pop_front(){
+Some(w)=>*w,
+None=>{
+slow=true;
+break;
+},
+};
+let(w,_)=bounded_int::div_rem(w,ns);
+let(w,b0)=bounded_int::div_rem(w,n8);
+bstep(b0,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b1)=bounded_int::div_rem(w,n8);
+bstep(b1,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b2)=bounded_int::div_rem(w,n8);
+bstep(b2,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b3)=bounded_int::div_rem(w,n8);
+bstep(b3,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b4)=bounded_int::div_rem(w,n8);
+bstep(b4,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(w,b5)=bounded_int::div_rem(w,n8);
+bstep(b5,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+let(b7,b6)=bounded_int::div_rem(w,n8);
+bstep(b6,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+bstep(b7,ref signs,ref lo,ref hi,ref list,ref i,two,k256,n128,bit);
+if i==256{break;}
+};
+if slow{
+return ball_slow(state,upcast(signs),lo,hi,list,i);
+}
+list
+}
+#[inline(always)]
+fn ball_step(bit:Span<u128>,ref lo:u128,ref hi:u128,ref list:Array<u32>,i:u32,j:u32,s:u32){
+let hit=if j<128{
+let b=*bit.at(j);
+if lo&b==0{
+lo=lo+b;
+false
+}else{
+true
+}
+}else{
+let b=*bit.at(j-128);
+if hi&b==0{
+hi=hi+b;
+false
+}else{
+true
+}
+};
+if hit{
+ball_hit(ref list,ref hi,i,j,s-j);
+}else{
+list.append(s-j);
+}
+}
+fn ball_slow(state:[u128;25],signs:u128,lo:u128,hi:u128,list:Array<u32>,i:u32)->Array<u32>{
+let mut signs=signs;
+let mut lo=lo;
+let mut hi=hi;
+let mut list=list;
+let mut i=i;
+let mut st=crate::k2::keccak_f1600_x2(state);
+let mut words=st.span().slice(0,17);
+let mut cur:u128=0;
+let mut left:u32=0;
+let two:NonZero<u128>=2_u128.try_into().unwrap();
+let byte:NonZero<u128>=256_u128.try_into().unwrap();
+let bit=BIT.span();
+while i !=256{
+if left==0{
+let w=match words.pop_front(){
+Some(w)=>*w,
+None=>{
+st=crate::k2::keccak_f1600_x2(st);
+let mut l=st.span().slice(0,17);
+let first=*l.pop_front().unwrap();
+words=l;
+first
+},
+};
+let(_,c)=crate::x2::halves(w);
+cur=c;
+left=8;
+}
+let(rest,b)=DivRem::div_rem(cur,byte);
+cur=rest;
+left-=1;
+let j:u32=b.try_into().unwrap();
+if j<=i{
+let(rest,sign)=DivRem::div_rem(signs,two);
+signs=rest;
+let s:u32=if sign==0{
+256
+}else{
+512
+};
+ball_step(bit,ref lo,ref hi,ref list,i,j,s);
+i+=1;
+}
+}
+list
+}
