+pub fn pk_from_sig(sig_fors:Span<u8>,md:Span<u8>,pk_seed:Span<u8>,adrs:Adrs)->Array<u8> {
+let indices=base_2b(md,A,K);
+let mut roots:Array<u8>=array![];
+let mut tree_adrs=adrs;
+let mut i=0;
+while i != K {
+let index=*indices.at(i);
+let offset=i * (1 + A) * N;
+tree_adrs.word2=0;
+tree_adrs.word3=i * 4096 + index;
+let leaf=thash(pk_seed,@tree_adrs,sig_fors.slice(offset,N));
+let root=climb(leaf,index,sig_fors.slice(offset + N,A * N),A,pk_seed,ref tree_adrs);
