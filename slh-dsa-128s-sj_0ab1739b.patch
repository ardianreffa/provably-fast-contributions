+mod digest_tests {
+use super::{digest_fields,out_bytes};
+fn byte_path_fields(hm:u256)->(Array<u64>,u64,u64) {
+let digest=out_bytes(hm);
+let dg=digest.span();
+let mut indices:Array<u64>=array![];
+let mut at=0;
+while at != 21 {
+let b0:u64=(*dg.at(at)).into();
+let b1:u64=(*dg.at(at + 1)).into();
+let b2:u64=(*dg.at(at + 2)).into();
+indices.append(b0 * 16 + b1 / 16);
+indices.append((b1 % 16) * 256 + b2);
+at += 3;
+}
+let mut tree:u64=(*dg.at(21)).into();
+at=22;
+while at != 28 {
+tree=tree * 256 + (*dg.at(at)).into();
+at += 1;
+}
+tree=tree % 0x40000000000000;
+let leaf=((*dg.at(28)).into() * 256 + (*dg.at(29)).into()) % 512;
+(indices,tree,leaf)
+}
+fn nib_ix(n:[super::Nb; 14])->[u64; 14] {
+let mut out:Array<u64>=array![];
+for (d0,d1,d2) in n.span() {
+out.append(super::upcast::<_,u64>(*d2) * 256 + super::upcast::<_,u64>(*d1) * 16 + super::upcast::<_,u64>(*d0));
+}
+let [i0,i1,i2,i3,i4,i5,i6,i7,i8,i9,i10,i11,i12,i13]=(*out.span().multi_pop_front::<14>().unwrap()).unbox();
+[i0,i1,i2,i3,i4,i5,i6,i7,i8,i9,i10,i11,i12,i13]
+}
+fn assert_digest_fields(hm:u256) {
+let (expected_indices,expected_tree,expected_leaf)=byte_path_fields(hm);
+let (nibbles,tree,leaf,leaf_lane,tree_lane)=digest_fields(hm,16,0x100,0x1000000);
+let indices=nib_ix(nibbles);
+let [i0,i1,i2,i3,i4,i5,i6,i7,i8,i9,i10,i11,i12,i13]=indices;
+assert!((i0) == *expected_indices.at(0));
+assert!((i1) == *expected_indices.at(1));
+assert!((i2) == *expected_indices.at(2));
+assert!((i3) == *expected_indices.at(3));
+assert!((i4) == *expected_indices.at(4));
+assert!((i5) == *expected_indices.at(5));
+assert!((i6) == *expected_indices.at(6));
+assert!((i7) == *expected_indices.at(7));
+assert!((i8) == *expected_indices.at(8));
+assert!((i9) == *expected_indices.at(9));
+assert!((i10) == *expected_indices.at(10));
+assert!((i11) == *expected_indices.at(11));
+assert!((i12) == *expected_indices.at(12));
+assert!((i13) == *expected_indices.at(13));
+assert!(super::upcast::<_,u64>(tree) == expected_tree);
+assert!(super::upcast::<_,u64>(leaf) == expected_leaf);
+assert!(
+super::upcast::<_,u64>(leaf_lane)
+== super::upcast::<_,u64>(super::bs32b(super::upcast(leaf),0x100))
+);
+assert!(tree_lane == super::bs64(super::upcast(tree)));
+}
+#[test]
+fn direct_digest_fields_match_current_semantics() {
+assert_digest_fields(u256 { low: 0,high: 0 });
+assert_digest_fields(u256 {
+low: 0xffffffffffffffffffffffffffffffff,
+high: 0xffffffffffffffffffffffffffffffff,
+});
+assert_digest_fields(u256 {
+low: 0x0f0e0d0c0b0a09080706050403020100,
+high: 0x001d1c1b1a19181716151413121110,
+});
+assert_digest_fields(u256 { low: 0,high: 0xc00000000000 });
+assert_digest_fields(u256 { low: 0,high: 0xff01000000000000000000000000 });
+}
