+        Rt128::rt(sw128(v1, mm), d, ref coeffs);
+        Rt128::rt(pad64(s9), d, ref coeffs);
+        Rt128::rt(sw128(u2, mm), d, ref coeffs);
+        Rt128::rt(sw128(v2, mm), d, ref coeffs);
+        Rt128::rt(pad64(l14), d, ref coeffs);
+        if rd(u3, mm, d, ref coeffs) { return; }
+        return last(st, ref coeffs, m128, d, kc);
+    }
+    let p = lpre(st, kc);
+    let (_, m64, _, _, _) = hcells();
+    let ([f0, o0, dk, bk, g0, dj, e4, ee, fk, _], (cj, cq, _, _, _)) = crate::fk::bb(p, crate::fk::mode1() + 1);
