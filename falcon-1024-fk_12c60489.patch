+#[inline(never)]
+fn last(st: ([u128; 10], crate::fk::bD), ref coeffs: Array<Acc5>, m128: u128, d: D16, kc: crate::fk::co) {
+    let n64 = kc.two64;
+    let mut st = st;
+    if near(@coeffs) {
+        let p = lpre(st, kc);
+        let (_, m64, _, _, _) = hcells();
+        let ([f0, hi, oo, _, _, _, _, _, _, _], (b00, b01, b02, b03, _)) = crate::fk::bb(p, crate::fk::mode1());
+        Rt128::rt(sw128(f0, m128), d, ref coeffs);
+        if full(@coeffs) { core::gas::redeposit_gas(); return; }
+        let (g0, b04) = crate::fk::row0v(hi, oo, b00, b02, b03, kc);
+        Rt128::rt(sw128(g0, m128), d, ref coeffs);
