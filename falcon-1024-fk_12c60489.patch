+fn group_v(e: [[Word; 3]; 6], o: [[Word; 3]; 6], fa: felt252, fb: felt252, r: pqbench_ntt::S, dv: NonZero<LaneBase>, nq: NonZero<UnitInt<12289>>) -> Option<(felt252, felt252)> {
+    let (ah, al) = crate::packing::hi9r(fa)?;
+    let ha = crate::packing::h9(al, nq)?;
+    let hb = crate::packing::h9p(ah, nq);
+    let (bh, bl) = crate::packing::hi9r(fb)?;
+    let hc = crate::packing::h9(bl, nq)?;
+    let hd = crate::packing::h9p(bh, nq);
+    let [e0, e1, e2, e3, e4, e5] = e;
+    let [o0, o1, o2, o3, o4, o5] = o;
+    let pqbench_ntt::S { a: r0, b: r1, c: r2, d: r3, e: r4, f: r5 } = r;
+    let (h0, h1, h2, h3, h4, h5, h6, h7, h8) = ha;
+    let (h9, h10, h11, h12, h13, h14, h15, h16, h17) = hb;
+    let (h18, h19, h20, h21, h22, h23, h24, h25, h26) = hc;
+    let (h27, h28, h29, h30, h31, h32, h33, h34, h35) = hd;
+    if !(trio(e0, o0, r0, [h0, h1, h2, h3, h4, h5], dv, nq) && trio(e1, o1, r1, [h6, h7, h8, h9, h10, h11], dv, nq)
+        && trio(e2, o2, r2, [h12, h13, h14, h15, h16, h17], dv, nq) && trio(e3, o3, r3, [h18, h19, h20, h21, h22, h23], dv, nq)
+        && trio(e4, o4, r4, [h24, h25, h26, h27, h28, h29], dv, nq)) {
+        return None;
+    }
+    let [x0, x1, x2] = e5;
+    let [y0, y1, y2] = o5;
+    let pqbench_ntt::R { a: w0, b: w1, c: w2 } = r5;
+    if !(pair(w0.into(), x0, y0, h30, h31, dv, nq) && pair(w1.into(), x1, y1, h32, h33, dv, nq)) {
+        return None;
+    }
+    Some(pair_v(w2.into(), x2, y2, h34, h35, dv, nq))
+}
+
+#[inline(never)]
+/// `pk`: 57 felts of 18 base-q digits of h (9 per u128 half).
+pub(crate) fn merge_check(
+    o: (Span<pqbench_ntt::F>, [Word; 8]), e: (Span<pqbench_ntt::F>, [Word; 8]), pk: Span<felt252>, dv: NonZero<LaneBase>, nq: NonZero<UnitInt<12289>>,
+) -> GS {
+    let (mo, to) = o;
+    let (me, te) = e;
+    let mut pt = pk;
+    let [e0, e1, e2, e3, e4, e5, e6, e7] = te;
+    let [o0, o1, o2, o3, o4, o5, o6, o7] = to;
+    let [w0, w1, w2, w3, w4, w5, w6, w7] = crate::ntt::ROOTS_T;
+    let Some(lf) = pt.pop_back() else { return failed(); };
+    let (lh, ll) = match crate::packing::hi7r(*lf) { Some(t) => t, None => { return failed(); } };
+    let (h0, h1, h2, h3, h4, h5, h6, h7, h8) = match crate::packing::h9(ll, nq) { Some(t) => t, None => { return failed(); } };
+    let (h9, h10, h11, h12, h13, h14, h15) = crate::packing::h7p(lh, nq);
+    if !(pair(w0.into(), e0, o0, h0, h1, dv, nq) && pair(w1.into(), e1, o1, h2, h3, dv, nq) && pair(w2.into(), e2, o2, h4, h5, dv, nq)
+        && pair(w3.into(), e3, o3, h6, h7, dv, nq) && pair(w4.into(), e4, o4, h8, h9, dv, nq)
+        && pair(w5.into(), e5, o5, h10, h11, dv, nq) && pair(w6.into(), e6, o6, h12, h13, dv, nq)
+    ) {
+        return failed();
+    }
+    let (u, v) = pair_v(w7.into(), e7, o7, h14, h15, dv, nq);
+    gw(gw(gw(gw(gw(gw(gw((me, mo, pk, crate::ntt::ROOTS_G.span(), dv, nq, u, v))))))))
+}
+
+/// The state of a failed check: empty spans and pending values (0, 1), which div_ok rejects.
+#[inline(always)]
+fn failed() -> GS {
+    (array![].span(), array![].span(), array![].span(), array![].span(), lane_base(), NQ, 0, 1)
+}
+
+/// The merge check's state between group calls.
+type GS = (Span<pqbench_ntt::F>, Span<pqbench_ntt::F>, Span<felt252>, Span<pqbench_ntt::Q>, NonZero<LaneBase>, NonZero<UnitInt<12289>>, felt252, felt252);
+
+/// Four groups of the 1024-point check as a call without gas builtin.
+#[inline(never)]
+fn gw(t: GS) -> GS {
+    core::internal::revoke_ap_tracking();
+    match gb(t) {
+        Some(t) => t,
+        None => failed(),
+    }
+}
+
+/// The state after the pending pair and four groups, or None on a failed check.
+#[inline(always)]
+fn gb(t: GS) -> Option<GS> {
+    let (me, mo, pk, ws, dv, nq, u, v) = t;
+    if !(div_ok(u) && div_ok(v)) {
+        return None;
+    }
+    let mut es = me;
+    let mut os = mo;
+    let mut pk = pk;
+    let mut ws = ws;
+    let Some(eb) = es.pop_front() else { return None; };
+    let pqbench_ntt::F { a: e0, b: e1, c: e2, d: e3 } = *eb;
+    let Some(ob) = os.pop_front() else { return None; };
+    let pqbench_ntt::F { a: o0, b: o1, c: o2, d: o3 } = *ob;
+    let Some(fb) = pk.multi_pop_front::<8>() else { return None; };
+    let [f0, f1, f2, f3, f4, f5, f6, f7] = (*fb).unbox();
+    let Some(wb) = ws.pop_front() else { return None; };
+    let pqbench_ntt::Q { a: g0, b: g1, c: g2, d: g3 } = *wb;
+    if !(group(e0.g, o0.g, f0, f1, g0, dv, nq) && group(e1.g, o1.g, f2, f3, g1, dv, nq) && group(e2.g, o2.g, f4, f5, g2, dv, nq)) {
+        return None;
+    }
+    let (u, v) = group_v(e3.g, o3.g, f6, f7, g3, dv, nq)?;
+    Some((es, os, pk, ws, dv, nq, u, v))
+}
+
+#[inline(always)]
+pub(crate) fn csq_diff(p: felt252, k: felt252) -> felt252 {
+    let x = p - k;
+    let a: Option<u128> = (x + 6144).try_into();
+    match a {
+        Option::Some(au) => {
+            if au <= 12288 {
+                x * x
+            } else {
+                let c = x - 12289;
+                c * c
+            }
+        },
+        Option::None => {
+            let c = x + 12289;
+            c * c
+        },
+    }
 }
