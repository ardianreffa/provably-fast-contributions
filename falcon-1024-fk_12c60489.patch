+    let (d9, d10, d11, d12, d13, d14, d15, d16, d17) = h9n(h, nq);
+    hs.append(d0); hs.append(d1); hs.append(d2); hs.append(d3); hs.append(d4); hs.append(d5);
+    hs.append(d6); hs.append(d7); hs.append(d8); hs.append(d9); hs.append(d10); hs.append(d11);
+    hs.append(d12); hs.append(d13); hs.append(d14); hs.append(d15); hs.append(d16); hs.append(d17);
+    true
+}
