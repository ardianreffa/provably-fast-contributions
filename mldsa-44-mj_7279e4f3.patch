+/// Appends `sign * v` for every v of `s` (a multiple of 16 long) to `f`, 16 at a time.
+fn copy16(ref f: Array<felt252>, s: Span<felt252>, sign: felt252) {
+    let mut s = s;
+    while let Some(g) = s.multi_pop_front::<16>() {
+        let [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15] = (*g).unbox();
+        f.append(sign * v0);
+        f.append(sign * v1);
+        f.append(sign * v2);
+        f.append(sign * v3);
+        f.append(sign * v4);
+        f.append(sign * v5);
+        f.append(sign * v6);
+        f.append(sign * v7);
+        f.append(sign * v8);
+        f.append(sign * v9);
+        f.append(sign * v10);
+        f.append(sign * v11);
+        f.append(sign * v12);
+        f.append(sign * v13);
+        f.append(sign * v14);
+        f.append(sign * v15);
+    }
+}
