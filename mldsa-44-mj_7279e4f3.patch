+/// The four z polynomials (1,024 coefficients) from the 79 signature felts, or None when a
+/// coefficient is out of range.
+pub fn z_from_felts(sig: Span<felt252>) -> Option<Array<felt252>> {
+    let mut out: Array<felt252> = array![];
+    let mut ok: u128 = 0xffffffffffffffffffffffffffffffff;
+    let mut p: u32 = 0;
+    while p != 8 {
+        ok = ok & period(sig, 1 + 9 * p, ref out);
+        p += 1;
+    }
+    let x: u256 = (*sig.at(73)).into();
+    let (f0lh, f0ll) = bounded_int::div_rem(x.low, N64);
+    let (f0hh, f0hl) = bounded_int::div_rem(x.high, N64);
+    let (f0r, _) = bounded_int::div_rem(f0ll, N8);
+    let a: u128 = upcast(f0r);
+    let (a, x0) = tk(a, ref out);
+    let (a, x1) = tk(a, ref out);
+    let (a, x2) = tk(a, ref out);
+    ok = ok & dg3(x0, x1, x2);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f0lh) * 4).try_into().unwrap();
+    let (a, x3) = tk(a, ref out);
+    let (a, x4) = tk(a, ref out);
+    let (a, x5) = tk(a, ref out);
+    ok = ok & dg3(x3, x4, x5);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f0hl) * 4096).try_into().unwrap();
+    let (a, x6) = tk(a, ref out);
+    let (a, x7) = tk(a, ref out);
+    let (a, x8) = tk(a, ref out);
+    ok = ok & dg3(x6, x7, x8);
+    let (a, x9) = tk(a, ref out);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f0hh) * 16).try_into().unwrap();
+    let (a, x10) = tk(a, ref out);
+    let (a, x11) = tk(a, ref out);
+    ok = ok & dg3(x9, x10, x11);
+    let (a, x12) = tk(a, ref out);
+    let x: u256 = (*sig.at(74)).into();
+    let (f1lh, f1ll) = bounded_int::div_rem(x.low, N64);
+    let (f1hh, f1hl) = bounded_int::div_rem(x.high, N64);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f1ll) * 64).try_into().unwrap();
+    let (a, x13) = tk(a, ref out);
+    let (a, x14) = tk(a, ref out);
+    ok = ok & dg3(x12, x13, x14);
+    let (a, x15) = tk(a, ref out);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f1lh) * 65536).try_into().unwrap();
+    let (a, x16) = tk(a, ref out);
+    let (a, x17) = tk(a, ref out);
+    ok = ok & dg3(x15, x16, x17);
+    let (a, x18) = tk(a, ref out);
+    let (a, x19) = tk(a, ref out);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f1hl) * 256).try_into().unwrap();
+    let (a, x20) = tk(a, ref out);
+    ok = ok & dg3(x18, x19, x20);
+    let (a, x21) = tk(a, ref out);
+    let (a, x22) = tk(a, ref out);
+    let (a, x23) = tk(a, ref out);
+    ok = ok & dg3(x21, x22, x23);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f1hh) * 1).try_into().unwrap();
+    let (a, x24) = tk(a, ref out);
+    let (a, x25) = tk(a, ref out);
+    let (a, x26) = tk(a, ref out);
+    ok = ok & dg3(x24, x25, x26);
+    let x: u256 = (*sig.at(75)).into();
+    let (f2lh, f2ll) = bounded_int::div_rem(x.low, N64);
+    let (_, f2r24) = bounded_int::div_rem(f2lh, N24);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f2ll) * 4).try_into().unwrap();
+    let (a, x27) = tk(a, ref out);
+    let (a, x28) = tk(a, ref out);
+    let (a, x29) = tk(a, ref out);
+    ok = ok & dg3(x27, x28, x29);
+    let a: u128 = (a.into() + upcast::<_, felt252>(f2r24) * 4096).try_into().unwrap();
+    let (a, x30) = tk(a, ref out);
+    let (a, x31) = tk(a, ref out);
+    ok = ok & dg3(x30, x31, 131072);
+    if ok & RANGE_MASK != RANGE_MASK {
+        return None;
+    }
+    Some(out)
+}
