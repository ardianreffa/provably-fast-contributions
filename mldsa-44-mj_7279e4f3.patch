+/// 2^17 in each of the eight 18-bit slots (four rows, low and high half).
+const BIAS: felt252 = 0x80002000080002000000000000000000800020000800020000;
+/// 2^30 + 129 q: w + this - 2^13 u is w - 2^13 (u - 2^17) shifted by a multiple of q, and is
+/// non-negative for u < 2^18.
+const CORR: felt252 = 2154815617;
+const N18: NonZero<UnitInt<0x40000>> = 0x40000;
+impl S18a of DivRemHelper<u128, UnitInt<0x40000>> {
+    type DivT = BoundedInt<0, 0x3fffffffffffffffffffffffffff>;
+    type RemT = BoundedInt<0, 0x3ffff>;
+}
+impl S18b of DivRemHelper<BoundedInt<0, 0x3fffffffffffffffffffffffffff>, UnitInt<0x40000>> {
+    type DivT = BoundedInt<0, 0xfffffffffffffffffffffff>;
+    type RemT = BoundedInt<0, 0x3ffff>;
+}
+impl S18c of DivRemHelper<BoundedInt<0, 0xfffffffffffffffffffffff>, UnitInt<0x40000>> {
+    type DivT = BoundedInt<0, 0x3ffffffffffffffffff>;
+    type RemT = BoundedInt<0, 0x3ffff>;
+}
