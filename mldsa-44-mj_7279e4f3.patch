+//! z read straight from the signature felts (FIPS 204 sigDecode's BitUnpack(z, gamma1 - 1,
+//! gamma1), Algorithm 27): bits 256 .. 18688 of the encoding, 18 bits a coefficient, with every
+//! shift fixed at compile time. Felt f holds the encoding's bits 248 f .. 248 f + 248, and
+//! lcm(248, 18) = 2232 bits = 9 felts = 124 coefficients, so from felt 1 bit 8 on the layout
+//! repeats: eight 9-felt periods (each ending in the next felt's low byte) and a tail of 32
+//! coefficients (felt 73 bit 8 to felt 75 bit 88). The felts' canonical form (31 bytes each,
+//! 11 in felt 78) is checked by the caller.
+
+use corelib_imports::bounded_int::{BoundedInt, DivRemHelper, UnitInt, bounded_int, upcast};
+
+type U64 = BoundedInt<0, 0xffffffffffffffff>;
+const N64: NonZero<UnitInt<0x10000000000000000>> = 0x10000000000000000;
+const N8: NonZero<UnitInt<0x100>> = 0x100;
+const N24: NonZero<UnitInt<0x1000000>> = 0x1000000;
+const N18: NonZero<UnitInt<0x40000>> = 0x40000;
+impl Z64 of DivRemHelper<u128, UnitInt<0x10000000000000000>> {
+    type DivT = U64;
+    type RemT = U64;
+}
+impl Z8 of DivRemHelper<U64, UnitInt<0x100>> {
+    type DivT = BoundedInt<0, 0xffffffffffffff>;
+    type RemT = BoundedInt<0, 0xff>;
+}
+impl Z8w of DivRemHelper<u128, UnitInt<0x100>> {
+    type DivT = BoundedInt<0, 0xffffffffffffffffffffffffffffff>;
+    type RemT = BoundedInt<0, 0xff>;
+}
+impl Z24 of DivRemHelper<U64, UnitInt<0x1000000>> {
+    type DivT = BoundedInt<0, 0xffffffffff>;
+    type RemT = BoundedInt<0, 0xffffff>;
+}
+impl Z18 of DivRemHelper<u128, UnitInt<0x40000>> {
+    type DivT = BoundedInt<0, 0x3fffffffffffffffffffffffffff>;
+    type RemT = BoundedInt<0, 0x3ffff>;
+}
+
+/// Bit 19 of each 20-bit range digit: a coefficient's digits x + 2^19 - 79 and
+/// 2^19 + 262065 - x lie in [0, 2^20) for every 18-bit x, and both have bit 19 set exactly when
+/// 79 <= x <= 262065 (|z| below gamma1 - beta). Three coefficients fill a word's six digits.
+pub(crate) const RANGE_MASK: u128 = 0x800008000080000800008000080000;
+
+/// The next 18-bit field of `a`: appends q + gamma1 - x and returns the rest of `a` and x.
+#[inline(always)]
+fn tk(a: u128, ref out: Array<felt252>) -> (u128, felt252) {
+    let (q, c) = bounded_int::div_rem(a, N18);
+    let x: felt252 = upcast(c);
+    out.append(8511489 - x);
+    (upcast(q), x)
+}
