+/// The range-digit word of three fields (see `RANGE_MASK`); 131072 (z = 0) pads a short group.
+#[inline(always)]
+fn dg3(x0: felt252, x1: felt252, x2: felt252) -> u128 {
+    ((x0 + 524209) + (786353 - x0) * 0x100000 + (x1 + 524209) * 0x10000000000
+        + (786353 - x1) * 0x1000000000000000 + (x2 + 524209) * 0x100000000000000000000
+        + (786353 - x2) * 0x10000000000000000000000000)
+        .try_into()
+        .unwrap()
+}
