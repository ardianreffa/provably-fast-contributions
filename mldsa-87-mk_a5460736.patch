+pub fn sig_decode(sig: Span<felt252>) -> Option<([u128; 8], Array<crate::nttu::ZC87>, Array<u8>)> {
+    if sig.len() != 150 {
+        return None;
+    }
+    let mut z: Array<crate::nttu::ZC87> = array![];
+    let mut rest = sig.slice(2, 140);
+    let mut carry: W = 0;
+    let mut ok: u128 = 0xffffffffffffffffffffffffffffffff;
+    let nk = ncells();
+    let mut first = true;
+    let mut ct_head: felt252 = 0;
+    while let Some(g) = rest.multi_pop_front::<5>() {
+        let (head, c, o) = g5((*g).unbox(), carry, first, ok, nk, ref z)?;
+        ok = o;
+        if first {
+            ct_head = head;
+        }
+        carry = c;
+        first = false;
+    }
+    let g = sig.slice(142, 5);
+    let v4: u256 = (*g[4]).into();
+    let (hint_low, zlow) = DivRem::div_rem(v4.high, P16);
+    let f4: felt252 = v4.low.into() + zlow.into() * 0x100000000000000000000000000000000 + PAD;
+    let (_, _, ok) = g5([*g[0], *g[1], *g[2], *g[3], f4], carry, false, ok, nk, ref z)?;
+    if ok & ZMASK != ZMASK {
+        return None;
+    }
+    let mut hint: Array<u8> = array![];
+    if crate::encoding::take13(hint_low, ref hint) != 0 {
+        return None;
+    }
+    for k in 147..149_u32 {
+        let v: u256 = (*sig.at(k)).into();
+        if crate::encoding::take16(v.low, ref hint) != 0 || crate::encoding::take15(v.high, ref hint) != 0 {
+            return None;
+        }
+    }
+    let v: u256 = (*sig.at(149)).into();
+    if v.high != 0 || crate::encoding::take8(v.low, ref hint) != 0 {
+        return None;
+    }
+    let ct = crate::keccak::lanes8(*sig[0], *sig[1], ct_head.try_into().unwrap())?;
+    Some((ct, z, hint))
+}
