+pub(crate) fn lanes8(f0: felt252, f1: felt252, head: u128) -> Option<[u128; 8]> {
+    let v: u256 = f0.into();
+    let w: u256 = f1.into();
+    if v.high >= 0x1000000000000000000000000000000 || w.high >= 0x1000000000000000000000000000000
+        || head >= 0x10000 {
