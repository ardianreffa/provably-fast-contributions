+    }
+    let (l1, l0) = DivRem::div_rem(v.low, L64);
+    let (t, l2) = DivRem::div_rem(v.high, L64);
+    let (wl, a) = DivRem::div_rem(w.low, L8);
+    let (c, b) = DivRem::div_rem(wl, L64);
+    let (wh, d) = DivRem::div_rem(w.high, L8);
+    let (g, e) = DivRem::div_rem(wh, L64);
+    Some([l0, l1, l2, t + a * 0x100000000000000, b, c + d * 0x100000000000000, e, g + head * 0x1000000000000])
