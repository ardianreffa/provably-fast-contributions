+    let tr = match crate::keccak::lanes8(*cache[0], *cache[1], (*cache[2]).try_into().unwrap()) {
+        Some(l) => l,
+        None => { return false; },
+    };
+    crate::verify::verify_decoded(tr, cache.slice(TR_FELTS, 8 * ROW_FELTS), message_hash, c_tilde, z.span(), hint.span())
+}
