+/// Ten coefficients (fewer at the end of a polynomial) as one stored felt.
+pub fn pack10(c: Span<felt252>) -> felt252 {
+    let mut lo: felt252 = 0;
+    let mut hi: felt252 = 0;
+    let mut scale: felt252 = 1;
+    let mut n: u32 = 0;
+    for x in c {
