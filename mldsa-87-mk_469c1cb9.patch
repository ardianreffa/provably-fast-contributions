+/// The signature's 150 felts as (c_tilde as 8 Keccak lanes, z's 1792 coefficients mod q and 5 padding
+/// entries, the hint's 83 bytes), or None for a malformed felt or a z over its bound.
+pub fn sig_decode(sig: Span<felt252>) -> Option<([u128; 8], Array<crate::nttu::ZC87>, Array<u8>)> {
+    if sig.len() != 150 {
+        return None;
+    }
+    let mut z: Array<crate::nttu::ZC87> = array![];
+    let mut rest = sig.slice(2, 140);
+    let mut carry: felt252 = 0;
+    let nk = ncells();
+    let mut first = true;
+    let mut ct_head: felt252 = 0;
+    while let Some(g) = rest.multi_pop_front::<5>() {
+        let (head, c) = g5((*g).unbox(), carry, first, nk, ref z)?;
+        if first {
+            ct_head = head;
+        }
+        carry = c;
+        first = false;
+    }
+    // The last group holds 56 coefficients, then the hint from felt 146's bit 144: those bits are
+    // read apart and replaced by fields decoding to z = 0, whose 5 coefficients are dropped.
+    let g = sig.slice(142, 5);
+    let v4: u256 = (*g[4]).into();
+    let (hint_low, zlow) = DivRem::div_rem(v4.high, P16);
+    let f4: felt252 = v4.low.into() + zlow.into() * 0x100000000000000000000000000000000 + PAD;
