+        return None;
+    }
+    let mut hint: Array<u8> = array![];
+    if crate::encoding::take_le(hint_low, 13, ref hint) != 0 {
+        return None;
+    }
+    for k in 147..149_u32 {
+        let v: u256 = (*sig.at(k)).into();
+        if crate::encoding::take_le(v.low, 16, ref hint) != 0 || crate::encoding::take_le(v.high, 15, ref hint) != 0 {
+            return None;
+        }
+    }
+    let v: u256 = (*sig.at(149)).into();
+    if v.high != 0 || crate::encoding::take_le(v.low, 8, ref hint) != 0 {
+        return None;
+    }
+    let ct = crate::keccak::lanes8(*sig[0], *sig[1], ct_head.try_into().unwrap())?;
