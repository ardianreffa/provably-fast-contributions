+impl ZcSub of corelib_imports::bounded_int::bounded_int::SubHelper<UnitInt<8904705>, ZX> {
+    type Result = crate::nttu::ZC87;
+}
+#[inline(always)]
+fn zc(x: felt252, zq: UnitInt<8904705>, ref out: Array<crate::nttu::ZC87>) -> bool {
+    let xb: ZX = match downcast(x) {
+        Some(v) => v,
+        None => { return false; },
+    };
+    out.append(corelib_imports::bounded_int::bounded_int::sub(zq, xb));
